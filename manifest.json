{
  "manifest_version": 3,
  "name": "Claude Smart-Guard",
  "version": "0.1.0",
  "description": "Advisory-only context tax guidance for claude.ai conversations.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Claude Smart-Guard",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "main_world.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "PruneEngine.js",
        "content_script.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "workers/*.js",
        "vendor/*"
      ],
      "matches": [
        "https://claude.ai/*"
      ]
    }
  ]
}
